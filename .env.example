# Copy to `.env` and adjust. Only VITE_-prefixed keys reach the browser bundle,
# so never put secrets here — everything below ships to the client.

VITE_APP_NAME="Klicpic Admin CRM"
# Backend origin + prefix. Must match PORT and API_PREFIX in backend/.env.
VITE_API_BASE_URL="http://localhost:5000/api/v1"
VITE_API_TIMEOUT=30000
